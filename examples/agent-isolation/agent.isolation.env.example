# DataNivra agent — isolated execution (ADR-0022). Copy into the agent's environment.
# Values are configuration only; credentials stay in your secret store (secret references).

# OCI (Docker/Podman), GVISOR (runsc registered with Docker) or FIRECRACKER (KVM). Default: STANDARD.
DATANIVRA_AGENT_ISOLATION_BACKEND=OCI

# The worker image: your agent release, pinned by digest (never a tag).
DATANIVRA_AGENT_ISOLATION_IMAGE=ghcr.io/manuelbomi/datanivra-agent@sha256:<digest-from-downloads>

# Container CLI the agent uses (docker or podman; a path is allowed).
DATANIVRA_AGENT_ISOLATION_RUNTIME_CLI=docker

# Networks for stages that read network sources / write network targets (see create-worker-networks.sh).
# Leave unset when all sources are files: such stages are then refused instead of getting a network.
DATANIVRA_AGENT_ISOLATION_SOURCE_NETWORK=dn-sources
DATANIVRA_AGENT_ISOLATION_TARGET_NETWORK=dn-targets

# Per-worker limits (defaults shown).
DATANIVRA_AGENT_ISOLATION_MEMORY_BYTES=4294967296
DATANIVRA_AGENT_ISOLATION_CPUS=2
DATANIVRA_AGENT_ISOLATION_PIDS_LIMIT=512
DATANIVRA_AGENT_ISOLATION_STAGE_TIMEOUT_SECONDS=21600

# Optional: refuse images not signed by the DataNivra release workflow (needs cosign v3 or later on the host).
# Use the signer identity and issuer published in the release's release-manifest.json (Downloads page).
# DATANIVRA_AGENT_ISOLATION_REQUIRE_IMAGE_SIGNATURE=true
# DATANIVRA_AGENT_ISOLATION_COSIGN_IDENTITY=<signing.certificate_identity from release-manifest.json>
# DATANIVRA_AGENT_ISOLATION_COSIGN_ISSUER=https://token.actions.githubusercontent.com

# Optional local floor: this agent refuses jobs below this level, whatever is requested.
# DATANIVRA_AGENT_ISOLATION_MINIMUM_LEVEL=CONTAINER
