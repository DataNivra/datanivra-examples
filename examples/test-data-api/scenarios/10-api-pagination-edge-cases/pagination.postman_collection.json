{
  "info": {
    "name": "DataNivra test data: pagination edge cases",
    "description": "Acquire approved synthetic data, test your API's pagination, release. Set the collection variables baseUrl and token (never commit a token).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://api.example.test"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "1. Request test data",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('created', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('requestId', pm.response.json().id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/v1/test-data/requests",
        "body": {
          "mode": "raw",
          "raw": "{\"profile\": {\"name\": \"edge-cases-core\", \"version\": 1}, \"scenarios\": [{\"scenario_code\": \"CORE_NORMAL\", \"count\": 1000}, {\"scenario_code\": \"CORE_NULL_HEAVY\", \"count\": 100}, {\"scenario_code\": \"CORE_INVALID\", \"count\": 50}]}"
        }
      }
    },
    {
      "name": "2. Wait until READY",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.json().state !== 'READY') { setTimeout(() => {}, 5000); postman.setNextRequest('2. Wait until READY'); }"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/v1/test-data/requests/{{requestId}}"
      }
    },
    {
      "name": "3. Your API: first page",
      "request": {
        "method": "GET",
        "url": "{{appUrl}}/orders?limit=100"
      }
    },
    {
      "name": "4. Release",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/v1/test-data/requests/{{requestId}}/release",
        "body": {
          "mode": "raw",
          "raw": "{\"reason_code\": \"TEST_RUN_FINISHED\"}"
        }
      }
    }
  ]
}
